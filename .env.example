# Токен от @BotFather
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Кому разрешено управлять (Telegram user id, через запятую).
# Свой id можно узнать командой /id — бот отвечает на неё всем.
ALLOWED_USERS=123456789

# Целевой компьютер
PC_NAME=Домашний ПК
PC_MAC=AA:BB:CC:DD:EE:FF
PC_HOST=10.10.10.50

# Broadcast-адрес вашей подсети. 255.255.255.255 работает не на всех
# интерфейсах — надёжнее указать явный, например 10.10.10.255
BROADCAST_IP=255.255.255.255

# Порты, куда шлётся magic packet
WOL_PORTS=9,7

# По каким TCP-портам проверять, что ПК поднялся.
# 3389 — RDP, 445 — SMB, 22 — SSH. Плюс всегда пробуется ICMP ping.
CHECK_PORTS=3389,445

# Команда, усыпляющая ПК. Пустая — кнопка «Усыпить» отвечает «не настроено».
# Вариант с OpenSSH Server на Windows (см. раздел «Сон» в README):
# SLEEP_COMMAND=ssh -i /etc/wolbot/id_sleep -o StrictHostKeyChecking=accept-new -o ConnectTimeout=10 user@10.10.10.10 "powershell -NoProfile -Command \"Add-Type -AssemblyName System.Windows.Forms; [System.Windows.Forms.Application]::SetSuspendState('Suspend',$false,$false)\""
SLEEP_COMMAND=

# Сколько секунд ждать загрузки/засыпания и как часто опрашивать
WAKE_TIMEOUT=180
SLEEP_TIMEOUT=90
POLL_INTERVAL=5

LOG_LEVEL=INFO
